{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Restaurant Billing",
  "version": "0.1.2",
  "identifier": "in.manokshmitechnologies.restaurantbilling",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Restaurant Billing",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon-32.png",
      "icons/icon-192.png",
      "icons/icon-512.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3RDZCMjUwMTc4NzA3NDUKUldSRkI0Y1hVTExXNS9MUkpXa0FoVnQzdE1laWFCcGplNEw2QnEwYnIvV1d1bDlmZnlkSC9ZRGsK",
      "endpoints": [
        "https://github.com/samarthtodmal17-coder/restaurent-billing-/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
