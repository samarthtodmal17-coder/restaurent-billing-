{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Restaurant Billing",
  "version": "0.1.0",
  "identifier": "in.manokshmitechnologies.restaurantbilling",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Restaurant Billing",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon-32.png",
      "icons/icon-192.png",
      "icons/icon-512.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_YOUR_GENERATED_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/YOUR_GITHUB_USER/YOUR_REPO/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
